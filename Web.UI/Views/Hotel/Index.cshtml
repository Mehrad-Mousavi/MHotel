@model List<Domain.Entities.Hotel>

@{
    ViewBag.Title = "Hotels";
}

<div class="table-container">
    <div class="data-header-wrapper">
        <h1 class="title">Hotels List</h1>
        <a href="@Url.Action("search", "Hotel")">Seaech Hotel</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                
                <th>HotelName</th>
                
                <th>PricePerNight</th>
                
                <th>Description</th>
                
                <th>StarRating</th>

                <th>IsActive</th>
            </tr>
        </thead>

        <tbody>
            @{ int RowId = 1; }

            @foreach (var item in Model)
            {
                <tr>
                    <td>@RowId</td>

                    <td>@item.HotelName</td>

                    <td>@item.PricePerNight</td>

                    <td>@item.Description</td>

                    <td>@item.StarRating</td>

                    <td>@item.IsActive</td>
                </tr>
                RowId++;
            }
        </tbody>
    </table>
</div>

 <script>

    function Search(Id) {
        $.ajax({
            url: '/Hotels/search',
            type: 'get',
            data: { Id: Id },
            success: function () {
                // window.location.href = '/hotels';
                window.location.reload();
            }
        });
    }
 </script>


