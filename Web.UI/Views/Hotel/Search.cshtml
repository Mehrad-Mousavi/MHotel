@model ViewModel.HotelSearchViewModel

@{
    ViewBag.Title = "Search";
}

<div class="card-container">
    <h1 class="title">Search</h1>
    <a href="@Url.Action("Index", "Hotel")">See hotels</a>
    <div class="card-wrapper">

        @using (Html.BeginForm())
        {

            <div class="form-group">
                @Html.LabelFor(Property => Property.HotelName)
                @Html.EditorFor(Property => Property.HotelName)
            </div>
            <div class="form-group">
                @Html.LabelFor(Property => Property.PricePerNight)
                @Html.EditorFor(Property => Property.PricePerNight)
            </div>

            <button type="submit">Search</button>
        }
    </div>
</div>

@if (Model.Results != null)
{
    if (Model.Results.Count == 0)
    {
        <p>
            Your Hotel not founded
        </p>
    }
    else
    {
        <div class="table-Container">
            <table>

                <thead>
                    <tr>
                        <th>#</th>
                        
                        <th>HotelName</th>
                        
                        <th>PricePerNight</th>
                    
                        <th>Description</th>

                        <th>StarRating</th>

                        <th>IsActive</th>
                    </tr>
                </thead>


                <tbody>

                    @{ int RowId = 1; }

                    @foreach (var item in Model.Results)
                    {
                        <tr>
                            <td>@RowId</td>
                            
                            <td>@item.HotelName</td>
                            
                            <td>@item.PricePerNight</td>

                            <td>@item.Description</td>

                            <td>@item.StarRating</td>

                            <td>@item.IsActive</td>
                          
                        </tr>
                        RowId++;

                    }
                </tbody>
            </table>
        </div>
    }
 }
